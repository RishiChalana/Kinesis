# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# PostgreSQL / TimescaleDB — local Docker instance
DATABASE_URL=postgresql://postgres:kinesis@localhost:5432/kinesis

# JWT signing key — generate your own, do NOT reuse anyone else's:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Parallel Cassandra landmark writer (dual-write alongside TimescaleDB).
# Off by default — set CASSANDRA_ENABLED=true to activate. The benchmark keyspace
# uses RF=1 on a single node; production uses NetworkTopologyStrategy RF=3.
# In docker-compose, set CASSANDRA_CONTACT_POINTS=cassandra.
CASSANDRA_ENABLED=false
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=kinesis
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_REPLICATION_FACTOR=1
